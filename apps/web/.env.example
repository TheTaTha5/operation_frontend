# Public build-time values (baked into the bundle). Never put secrets in VITE_* variables.
# Path the app is served under. It shares an origin with server.js so the `sess` cookie is shared.
VITE_BASE=/app/
# Where the legacy app lives; pages not yet moved link to <this>?view=<data-view>.
VITE_LEGACY_URL=/allotment_v2/allotment_v2.html
VITE_APP_ENV=local
# Dev server only: the server.js that /api, /auth and /allotment_v2 are proxied to.
DEV_BACKEND_URL=http://localhost:3000
